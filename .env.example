# Generate once: openssl rand -hex 32
SERVITAS_BOOTSTRAP_TOKEN=

# Local Compose defaults. pnpm dev uses http://localhost:3000 when this is unset.
# SERVITAS_ORIGIN=http://localhost:8080

# Local app URLs are <app-name>.apps.localhost:8080.
# SERVITAS_APPS_ORIGIN=http://apps.localhost:8080

# For public HTTPS, set your domain and publish the standard ports:
# SERVITAS_ORIGIN=https://cloud.example.com
# SERVITAS_ADDRESS=cloud.example.com
# SERVITAS_APPS_ORIGIN=https://apps.example.com
# Point cloud.example.com and *.apps.example.com at the same server.
# SERVITAS_HTTP_BIND=0.0.0.0:80
# SERVITAS_HTTPS_BIND=0.0.0.0:443

# Override if Docker uses a different Unix socket on the host.
# SERVITAS_DOCKER_SOCKET=/var/run/docker.sock
