{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "type": "number", "const": 1 },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "healthCheck": { "default": "/", "type": "string", "maxLength": 2048, "pattern": "^\\/.*" },
    "access": { "default": "private", "type": "string", "enum": ["private", "public"] },
    "resources": {
      "default": { "memoryMb": 256, "cpu": 1 },
      "type": "object",
      "properties": {
        "memoryMb": { "type": "integer", "minimum": 64, "maximum": 65536 },
        "cpu": { "type": "number", "minimum": 0.1, "maximum": 64 }
      },
      "required": ["memoryMb", "cpu"],
      "additionalProperties": false
    },
    "volumes": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "mountPath": {
            "type": "string",
            "pattern": "^\\/(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9_/-]+$"
          }
        },
        "required": ["name", "mountPath"],
        "additionalProperties": false
      }
    },
    "requiredEnv": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "image" },
            "image": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:-]*$"
            }
          },
          "required": ["type", "image"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "git" },
            "url": { "type": "string", "format": "uri" },
            "revision": { "type": "string", "minLength": 1, "maxLength": 255 },
            "dockerfile": {
              "default": "Dockerfile",
              "type": "string",
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9_./-]+$"
            }
          },
          "required": ["type", "url", "revision", "dockerfile"],
          "additionalProperties": false
        }
      ]
    },
    "$schema": { "type": "string", "format": "uri" }
  },
  "required": [
    "version",
    "name",
    "port",
    "healthCheck",
    "access",
    "resources",
    "volumes",
    "requiredEnv"
  ],
  "additionalProperties": false
}
