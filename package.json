{
  "name": "servitas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "build": "pnpm --filter @servitas/web build && pnpm --filter @servitas/worker build",
    "typecheck": "tsc --noEmit && pnpm --filter @servitas/web typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:compose": "tsx scripts/test-compose.ts",
    "check": "pnpm typecheck && pnpm test",
    "owner:reset": "node --env-file-if-exists=.env --import tsx scripts/reset-owner.ts",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check .",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "test:backups": "tsx scripts/test-backups.ts",
    "test:beta": "tsx scripts/test-backups.ts --beta"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
